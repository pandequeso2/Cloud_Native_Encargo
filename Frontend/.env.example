# App Registration del SPA (frontend) en Microsoft Entra ID
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID de Entra ID
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Client ID del App Registration del BACKEND (el mismo que usa el Gateway
# como ENTRA_AUDIENCE). Se usa para armar el scope api://<id>/access_as_user
VITE_ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# URL base del Gateway (BFF)
VITE_API_BASE_URL=http://localhost:8095

# Debe coincidir EXACTO con un Redirect URI registrado en el App
# Registration del SPA (plataforma "Single-page application")
VITE_REDIRECT_URI=http://localhost:5173
